# Template for the two untracked settings files:
#   .env             local: seeds .secrets/local/app.env on `make init-local` (existing values take precedence)
#   .env.production  production: copy this file, then change the lines marked PRODUCTION below;
#                    `make init-prod` imports it into .secrets/prod/app.env (see docs/DEPLOYMENT.md).
# Neither file is committed (.gitignore excludes .env.*). Credentials stay on the server.

# --- Deployment (production only; read by make init-prod) ---
# DOMAIN=app.example.com
# Let's Encrypt contact address:
# ACME_EMAIL=you@example.com
# Immutable release image, from make publish:
# APP_IMAGE=registry/samen-klaar@sha256:...

APP_NAME=SamenKlaar
# PRODUCTION: production
APP_ENV=development
APP_ADDR=0.0.0.0:8080
WEB_DIR=/app/dist
# PRODUCTION: https://<DOMAIN>, no path
APP_BASE_URL=http://localhost:8090

# AI coordination. Credentials stay on the Go server.
# Options: gemini | openai | claude. AI_PROVIDER_KEY is that provider's API key, and
# AI_MODEL must be one of that provider's model IDs.
AI_PROVIDER=claude
AI_PROVIDER_KEY=
AI_MODEL=claude-haiku-5-5
# Optional, claude only: low | medium | high | xhigh | max. Empty uses the model default.
# Lower is cheaper and faster; raise it if answers are too shallow.
AI_EFFORT=low

# Private evidence storage.
EVIDENCE_PROVIDER=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
CLOUDFLARE_R2_PUBLIC_BUCKET_URL=

# PayPal marketplace sandbox credentials. The API routes customer payments to
# the connected professional. The application refuses to start with anything but
# PAYMENT_PROVIDER=paypal_sandbox and PAYPAL_ENV=sandbox, in production too: live money stays
# disabled until PayPal approves the platform. In production register a webhook at
# https://<DOMAIN>/api/paypal/webhook on the same sandbox app and use its ID below.
PAYMENT_PROVIDER=paypal_sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Merchant ID and BN attribution code for the PayPal platform sandbox account.
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=

# PostgreSQL stores account memberships, sessions and account-owned state.
# PRODUCTION: generated by make init-prod (postgres://samenklaar:<generated>@db:5432/samenklaar?sslmode=disable&pool_max_conns=10&pool_min_conns=2).
DATABASE_URL=

# Auth0 Universal Login. Register the callback and logout URLs in the Auth0 app.
# Use the Auth0 tenant issuer URL and the application's Client ID and Client Secret.
AUTH0_ISSUER_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# PRODUCTION: https://<DOMAIN>/api/auth/callback
AUTH0_REDIRECT_URI=http://localhost:8090/api/auth/callback

# Transactional service updates. Use an SMTP relay that supports STARTTLS on
# port 587/2525 or implicit TLS on port 465. Credentials are optional for local relays.
# Optional: without SMTP_ADDR the app runs and notification emails stay queued. SMTP_USERNAME and
# SMTP_PASSWORD must be set together. Set up SPF, DKIM and DMARC for the sender domain first.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional display name; defaults to SamenKlaar.
SMTP_FROM_NAME=

# Address search (Mapbox Geocoding v6), server-side token. Optional: without it address search is off.
# Enable billing on the Mapbox account for permanent geocoding.
MAPBOX_ACCESS_TOKEN=
