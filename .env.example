# Optional credential import template for local initialization and deployment.
# Active Docker configuration is .secrets/local/app.env; existing values take precedence.
APP_NAME=SamenKlaar
APP_ENV=development
APP_ADDR=0.0.0.0:8080
WEB_DIR=/app/dist
APP_BASE_URL=http://localhost:8090

# AI coordination. Credentials stay on the Go server.
AI_PROVIDER=gemini
AI_PROVIDER_KEY=
AI_MODEL=gemini-3.8-flash

# Private evidence storage.
EVIDENCE_PROVIDER=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
CLOUDFLARE_R2_PUBLIC_BUCKET_URL=

# PayPal marketplace sandbox credentials. The API routes customer payments to
# the connected professional; do not configure production API credentials here.
PAYMENT_PROVIDER=paypal_sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Merchant ID and BN attribution code for the PayPal platform sandbox account.
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=

# PostgreSQL stores account memberships, sessions and account-owned state.
DATABASE_URL=

# Auth0 Universal Login. Register the callback and logout URLs in the Auth0 app.
# Use the Auth0 tenant issuer URL and the application's Client ID and Client Secret.
AUTH0_ISSUER_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://localhost:8090/api/auth/callback

# Transactional service updates. Use an SMTP relay that supports STARTTLS on
# port 587 or implicit TLS on port 465. Credentials are optional for local relays.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional evaluated Jev adapter; not wired into the current request flow.
JEV_API_KEY=
JEV_MODEL=
