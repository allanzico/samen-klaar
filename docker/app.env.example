# Literal KEY=value settings; no shell expansion. Generated DATABASE_URL and
# APP_BASE_URL are filled by make init-local / make init-prod. Matching settings are then imported from
# .env (local) or .env.production (production), which are never committed.
APP_NAME=SamenKlaar
APP_BASE_URL=__BASE_URL__
DATABASE_URL=postgres://samenklaar:__DB_PASSWORD__@db:5432/samenklaar?sslmode=disable&pool_max_conns=10&pool_min_conns=2
# Auth0 tenant issuer URL and application credentials.
AUTH0_ISSUER_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=__BASE_URL__/api/auth/callback
# Options: gemini | openai | claude (alias: anthropic). AI_PROVIDER_KEY is that provider's API key, and
# AI_MODEL must be one of that provider's model IDs.
AI_PROVIDER=gemini
AI_PROVIDER_KEY=
AI_MODEL=gemini-3.8-flash
EVIDENCE_PROVIDER=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
PAYMENT_PROVIDER=paypal_sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Merchant ID and BN attribution code for the PayPal platform sandbox account.
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Transactional email. Optional: without SMTP_ADDR the app runs and notification emails stay queued;
# SMTP_USERNAME and SMTP_PASSWORD must be set together. STARTTLS on 587 or implicit TLS on 465.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
